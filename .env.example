# Runtime mode: development, test, or production.
APP_ENV=development

# Supabase project settings. The URL and publishable key are public client
# configuration. The service-role key is server-only and must never be placed
# in frontend files, logs, screenshots, documentation, or chat.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Access-token verification. Ally's linked project currently publishes ES256
# keys through JWKS. Use legacy only for a project verified to use legacy HS256.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_VERIFICATION_MODE=auto
SUPABASE_JWT_ALGORITHMS=ES256
AUTH_JWKS_CACHE_SECONDS=600

# Exact comma-separated browser origins; never use * in production.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://ally-vimd.onrender.com

# Public API origin only (no path, query, fragment, or credentials). Required
# with both signing keys before the QStash worker endpoint is enabled.
API_PUBLIC_URL=https://ally-back.onrender.com

# QStash inbound verification keys are server-only secrets. QSTASH_TOKEN is a
# separate schedule-management secret used only by the provisioning command.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_TOKEN=
QSTASH_SCHEDULE_ID=ally-reminders-production

# Daily at 06:00 Europe/London, including daylight-saving changes. QStash owns
# and executes this timezone-aware cron; Ally also uses the same IANA timezone
# when deciding which action calendar date is due.
REMINDER_CRON=CRON_TZ=Europe/London 0 6 * * *
REMINDER_TIMEZONE=Europe/London
REMINDER_BATCH_SIZE=50
REMINDER_MAX_ATTEMPTS=4
REMINDER_LEASE_SECONDS=180
REMINDER_RETRY_BASE_SECONDS=60
ACTION_STATUS_LINK_TTL_HOURS=72

# Request and upload limits.
MAX_DOCUMENT_UPLOAD_MB=10
MAX_AUDIO_UPLOAD_MB=100
MAX_EMAIL_ATTACHMENT_MB=10
MAX_EMAIL_TOTAL_ATTACHMENT_MB=20
MAX_EMAIL_RECIPIENTS=10
MAX_AI_TEXT_CHARS=100000
MAX_EMAIL_SUBJECT_CHARS=200
MAX_EMAIL_HTML_CHARS=200000

# Shared database-backed cost controls.
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_AI_PER_DAY=200
RATE_LIMIT_TRANSCRIPTION_PER_MINUTE=3
RATE_LIMIT_TRANSCRIPTION_PER_DAY=30
RATE_LIMIT_DOCUMENT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_EMAIL_PER_HOUR=10
RATE_LIMIT_WELCOME_EMAIL_PER_DAY=1
RATE_LIMIT_REMINDER_PER_HOUR=10

# Existing providers retained in Phase 2B. Add real values only to a local or
# deployment environment, never to this example file.
GOOGLE_API_KEY=
ASSEMBLYAI_API_KEY=
BREVO_API_KEY=
SENDER_EMAIL=
SENDER_NAME=Ally, your AI Meeting Wizard
